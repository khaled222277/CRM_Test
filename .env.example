# Copy to .env and fill in real values.

# SQLite for local dev. Swap for PostgreSQL by changing this line only, e.g.
# DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
DATABASE_URL=sqlite:///./crm.db

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

PROJECT_NAME=CRM API

# Comma-separated browser origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
